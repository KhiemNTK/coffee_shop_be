// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

generator zod {
  provider          = "zod-prisma-types"
  output            = "../src/generated/zod"
  useTypeAssertions = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator custom_generator {
  provider = "prisma-generator-fake-data"
  output   = "../src/generated/faker/data.ts"
}

// =============================================
// ENUMS (Chuẩn hóa trạng thái dữ liệu)
// =============================================
enum TableStatus {
  EMPTY
  OCCUPIED
  RESERVED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ServeStatus {
  PENDING
  COOKING
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum InventoryTxType {
  IMPORT
  EXPORT
}

enum CashFlowType {
  INCOME // Thu
  EXPENSE // Chi
}

enum DiscountType {
  PERCENTAGE // Giảm giá theo %
  FIXED_AMOUNT // Giảm giá theo số tiền cố định
}

enum ReservationStatus {
  PENDING
  ARRIVED
  CANCELLED
  NO_SHOW
}

enum EquipmentStatus {
  IN_USE // Đang sử dụng
  MAINTENANCE // Đang bảo trì / Sửa chữa
  BROKEN // Hỏng hóc
  LIQUIDATED // Đã thanh lý
}

enum ShiftStatus {
  OPEN // Ca đang mở
  CLOSED // Đã chốt ca
}

// =============================================
// 0. AUTH & AUTHORIZATION (Phân quyền hệ thống)
// =============================================

model Role {
  id           String  @id @default(uuid())
  name         String
  description  String?
  isSystemRole Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]
  employeeRoles   EmployeeRole[]

  @@index([name])
  @@index([deletedAt])
}

model Permission {
  id                 String  @id @default(uuid())
  name               String
  description        String?
  key                String /// @zod.string.describe("Pattern: [/resource]_[action], e.g: [/product]_[read]")
  isSystemPermission Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]

  @@index([key])
  @@index([deletedAt])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model EmployeeRole {
  employeeId String
  roleId     String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
  @@index([roleId])
}

// =============================================
// 1. MASTER TABLES (Bảng danh mục)
// =============================================

model Position {
  id     String  @id @default(uuid())
  name   String
  salary Decimal

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees Employee[]
}

model DiningTable {
  id     String      @id @default(uuid())
  name   String
  status TableStatus @default(EMPTY)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reservations  Reservation[]
  orderSessions OrderSession[]
}

model Fund {
  id      String  @id @default(uuid())
  name    String // VD: Tiền mặt tại két, Tài khoản Vietcombank
  balance Decimal @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cashTransactions CashTransaction[]
}

model MenuCategory {
  id          String  @id @default(uuid())
  name        String // VD: Cà phê, Sinh tố, Bánh ngọt
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  menuItems MenuItem[]
}

model MenuItem {
  id    String  @id @default(uuid())
  name  String
  price Decimal

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orderItems  OrderItem[]
  ingredients MenuItemIngredient[]
}

model Promotion {
  id            String       @id @default(uuid()) // MaKhuyenMai
  name          String // TenKhuyenMai
  startDate     DateTime // NgayBatDau
  endDate       DateTime // NgayKetThuc
  discountType  DiscountType
  discountValue Decimal // Giá trị giảm giá (ví dụ: 10 cho 10% hoặc 50000 cho 50.000đ)
  maxDiscount   Decimal?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoices Invoice[]

  @@index([deletedAt])
  @@index([startDate, endDate])
  @@index([discountType])
  @@index([createdAt])
  @@index([name])
}

model Unit {
  id   String @id @default(uuid()) // MaDonViTinh
  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  inventoryItems InventoryItem[]

  @@index([deletedAt])
  @@index([name])
}

model Equipment {
  id           String          @id @default(uuid()) // MaThietBi
  name         String
  quantity     Int
  unitPrice    Decimal
  totalAmount  Decimal
  purchaseDate DateTime
  status       EquipmentStatus @default(IN_USE) // Quản lý vòng đời thiết bị

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  cashTransactionId String?          @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)
}

// =============================================
// 2. ENTITY TABLES (Các bảng thực thể chứa khóa ngoại)
// =============================================

model Employee {
  id          String   @id @default(uuid()) // MaNhanVien
  email       String   @unique /// @zod.string.email()
  avatarUrl   String?
  fullName    String // HoTen
  address     String? // DiaChi
  phoneNumber String? // SoDienThoai
  username    String   @unique // TenDangNhap
  ///FAKE:faker.internet.password()
  password    String // MatKhau
  salary      Decimal?
  isActive    Boolean  @default(true) // TrangThai

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  positionId String // MaChucVu
  position   Position @relation(fields: [positionId], references: [id])

  employeeRoles    EmployeeRole[]
  orderSessions    OrderSession[]
  invoices         Invoice[]
  actionLogs       ActionLog[]
  cashTransactions CashTransaction[]
  reservations     Reservation[]
  equipment        Equipment[]
  printSetting     PrintSetting?
  shifts           CashierShift[]
}

model InventoryCategory {
  id          String  @id @default(uuid())
  name        String // VD: Nguyên liệu pha chế, Đồ đóng chai, Vật dụng
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  inventoryItems InventoryItem[]

  @@index([deletedAt])
  @@index([name])
}

model InventoryItem {
  id    String  @id @default(uuid()) // MaHangHoa
  name  String // TenHangHoa
  stock Decimal @default(0) // Số lượng tồn kho hiện tại

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categoryId String
  category   InventoryCategory @relation(fields: [categoryId], references: [id])

  unitId String // MaDonViTinh
  unit   Unit   @relation(fields: [unitId], references: [id])

  ingredients  MenuItemIngredient[]
  transactions InventoryTransaction[]

  @@index([categoryId])
  @@index([unitId])
  @@index([deletedAt])
  @@index([name])
  @@index([stock])
}

// =============================================
// 3. DETAIL / JUNCTION TABLES
// =============================================

model Reservation {
  id              Int               @id @default(autoincrement()) // MaCTDatBan
  customerName    String?
  phoneNumber     String
  reservationDate DateTime
  reservationTime DateTime
  status          ReservationStatus @default(PENDING) // Trạng thái đặt bàn

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId String // MaBan
  table   DiningTable @relation(fields: [tableId], references: [id])

  employeeId String // MaNhanVien
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model CashierShift {
  id                 String      @id @default(uuid())
  openedAt           DateTime    @default(now())
  closedAt           DateTime?
  startingCash       Decimal     @default(0) // Tiền lẻ có sẵn đầu ca
  reportedEndingCash Decimal? // Số tiền mặt thu ngân đếm được khi chốt ca
  actualEndingCash   Decimal? // Số tiền mặt hệ thống tính toán (để kiểm tra chênh lệch)
  status             ShiftStatus @default(OPEN)

  employeeId String // Ai là người giữ ca này
  employee   Employee @relation(fields: [employeeId], references: [id])

  orderSessions    OrderSession[]
  invoices         Invoice[]
  cashTransactions CashTransaction[] // Lưu các khoản thu/chi phát sinh trong ca
}

model MenuItemIngredient {
  menuItemId String // MaThucDon
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  inventoryItemId String // MaHangHoa
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  quantity Decimal // DinhLuong

  createdAt DateTime @default(now())

  @@id([menuItemId, inventoryItemId])
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  type            InventoryTxType // IMPORT (Nhập), EXPORT (Xuất)
  quantity        Decimal
  unitPrice       Decimal?
  totalAmount     Decimal?
  transactionDate DateTime
  note            String?

  createdAt DateTime @default(now())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([type, transactionDate])
  @@index([transactionDate])
  @@index([inventoryItemId, transactionDate])
}

// =============================================
// 4. OTHER TABLES
// =============================================

model SystemSetting {
  id          String  @id @default(uuid()) // MaCaiDat
  value       String // GiaTri
  description String? // MoTa

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================
// REFACTORED: F&B CORE TRANSACTIONS
// =============================================

// Quản lý Phiên phục vụ (Đại diện cho 1 lần khách vào quán)
model OrderSession {
  id            String        @id @default(uuid())
  sessionStatus SessionStatus @default(ACTIVE) // TinhTrang: ACTIVE, COMPLETED, CANCELLED
  guestCount    Int? // So luong khach

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId String? // MaBan (Có thể null nếu bán mang đi - Takeaway)
  table   DiningTable? @relation(fields: [tableId], references: [id])

  employeeId String // Nhan vien phuc vu/mo ban
  employee   Employee @relation(fields: [employeeId], references: [id])

  orderItems OrderItem[]
  invoices   Invoice[] // 1 Session có thể xuất ra nhiều Invoices (Tách Bill)

  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id])

  @@index([sessionStatus, createdAt])
  @@index([tableId, sessionStatus])
  @@index([employeeId])
  @@index([shiftId])
}

//Chi tiết món ăn khách gọi trong phiên
model OrderItem {
  id          String  @id @default(uuid())
  quantity    Int
  priceAtTime Decimal // GiaTien tai thoi diem goi
  note        String? // Ghi chu (VD: Khong hanh)

  serveStatus ServeStatus @default(PENDING) // TrangThaiBep: PENDING, COOKING, SERVED, CANCELLED
  isPaid      Boolean     @default(false) // Danh dau mon da duoc thanh toan chua

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderSessionId String
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id])

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([orderSessionId])
  @@index([menuItemId])
  @@index([invoiceId])
  @@index([serveStatus])
  @@index([isPaid])
}

// Hóa đơn thanh toán - In phiếu thanh toán
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  subTotal       Decimal // Tổng tiền hàng
  discountAmount Decimal       @default(0) // Tiền giảm giá
  totalAmount    Decimal // Tiền thực thu
  amountTendered Decimal? // Tiền khách đưa
  changeAmount   Decimal? // Tiền thối lại
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(PENDING)
  taxAmount      Decimal       @default(0) // Số tiền thuế
  taxRate        Decimal       @default(0) // % Thuế (VD: 8, 10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderSessionId String
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id])

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([orderSessionId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
}

// Quản lý Ngân sách / Thu Chi (NGANSACH.THU, CHI, NGAY, SOTIEN)
model CashTransaction {
  id              String       @id @default(uuid())
  type            CashFlowType // INCOME (Thu), EXPENSE (Chi)
  amount          Decimal
  description     String
  transactionDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fundId String // Nguồn tiền xuất/nhập
  fund   Fund   @relation(fields: [fundId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  shiftId String? // Khoản chi/thu này phát sinh trong ca nào
  shift   CashierShift? @relation(fields: [shiftId], references: [id])

  equipment Equipment?
}

// Cài đặt in ấn máy POS
model PrintSetting {
  id          String @id @default(uuid())
  paperSize   String // Khổ giấy
  printerName String // Máy in
  printLimit  Int    @default(1) // Số lần in/giới hạn in

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// Lịch sử thao tác nghiệp vụ (Audit Log)
model ActionLog {
  id         String @id @default(uuid())
  actionType String // VD: TRANSFER_TABLE, MERGE_TABLE, CANCEL_ITEM
  details    Json // Dữ liệu chi tiết sự thay đổi

  createdAt DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
}
