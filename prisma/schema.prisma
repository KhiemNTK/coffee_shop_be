// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

generator zod {
  provider          = "zod-prisma-types"
  output            = "../src/generated/zod"
  useTypeAssertions = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator custom_generator {
  provider = "prisma-generator-fake-data"
  output   = "../src/generated/faker/data.ts"
}

// =============================================
// ENUMS (Chuẩn hóa trạng thái dữ liệu)
// =============================================
enum TableStatus {
  EMPTY
  OCCUPIED
  RESERVED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ServeStatus {
  PENDING
  COOKING
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentProvider {
  VNPAY
}

enum PaymentAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum IdempotencyRequestStatus {
  PROCESSING
  COMPLETED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD_LETTER
}

enum InventoryTxType {
  IMPORT
  EXPORT
}

enum CashFlowType {
  INCOME // Thu
  EXPENSE // Chi
}

enum FundType {
  CASH
  BANK
  OTHER
}

enum DiscountType {
  PERCENTAGE // Giảm giá theo %
  FIXED_AMOUNT // Giảm giá theo số tiền cố định
}

enum ReservationStatus {
  PENDING
  ARRIVED
  CANCELLED
  NO_SHOW
}

enum EquipmentStatus {
  IN_USE // Đang sử dụng
  MAINTENANCE // Đang bảo trì / Sửa chữa
  BROKEN // Hỏng hóc
  LIQUIDATED // Đã thanh lý
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum ShiftStatus {
  OPEN // Ca đang mở
  CLOSED // Đã chốt ca
}

enum CashExpenseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CashHandoverStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CashHandoverSettlementStatus {
  NOT_REQUIRED
  PENDING
  SETTLED
}

enum BankStatementEntryDirection {
  CREDIT
  DEBIT
}

enum BankStatementMatchStatus {
  UNMATCHED
  MATCHED
  MISMATCH
  IGNORED
}

// =============================================
// 0. AUTH & AUTHORIZATION (Phân quyền hệ thống)
// =============================================

model Role {
  id           String  @id @default(uuid())
  name         String
  description  String?
  isSystemRole Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]
  employeeRoles   EmployeeRole[]

  @@index([name])
  @@index([deletedAt])
}

model Permission {
  id                 String  @id @default(uuid())
  name               String
  description        String?
  key                String /// @zod.string.describe("Pattern: [/resource]_[action], e.g: [/product]_[read]")
  isSystemPermission Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rolePermissions RolePermission[]

  @@index([key])
  @@index([deletedAt])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model EmployeeRole {
  employeeId String
  roleId     String
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
  @@index([roleId])
}

// =============================================
// 1. MASTER TABLES (Bảng danh mục)
// =============================================

model Position {
  id     String  @id @default(uuid())
  name   String
  salary Decimal @db.Decimal(18, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees Employee[]
}

model DiningTable {
  id     String      @id @default(uuid())
  name   String
  status TableStatus @default(EMPTY)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  reservations  Reservation[]
  orderSessions OrderSession[]
}

model Fund {
  id      String   @id @default(uuid())
  name    String // VD: Tiền mặt tại két, Tài khoản Vietcombank
  balance Decimal  @default(0) @db.Decimal(18, 2)
  type    FundType

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  cashTransactions  CashTransaction[]
  shifts            CashierShift[]
  expenseRequests   CashExpenseRequest[]
  outgoingHandovers CashHandover[]        @relation("CashHandoverSourceFund")
  incomingHandovers CashHandover[]        @relation("CashHandoverDestinationFund")
  statementImports  BankStatementImport[]
  statementEntries  BankStatementEntry[]

  @@index([deletedAt, type])
}

model MenuCategory {
  id          String  @id @default(uuid())
  name        String // VD: Cà phê, Sinh tố, Bánh ngọt
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  menuItems MenuItem[]

  @@index([deletedAt, name])
}

model MenuItem {
  id          String  @id @default(uuid())
  name        String
  price       Decimal @db.Decimal(18, 2)
  isAvailable Boolean @default(true)

  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orderItems  OrderItem[]
  ingredients MenuItemIngredient[]

  @@index([deletedAt, categoryId, isAvailable])
}

model Promotion {
  id            String       @id @default(uuid()) // MaKhuyenMai
  name          String // TenKhuyenMai
  startDate     DateTime // NgayBatDau
  endDate       DateTime // NgayKetThuc
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(18, 2) // Giá trị giảm giá (ví dụ: 10 cho 10% hoặc 50000 cho 50.000đ)
  maxDiscount   Decimal?     @db.Decimal(18, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  invoices Invoice[]

  @@index([deletedAt])
  @@index([startDate, endDate])
  @@index([discountType])
  @@index([createdAt])
  @@index([name])
}

model Unit {
  id   String @id @default(uuid()) // MaDonViTinh
  name String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  inventoryItems InventoryItem[]

  @@index([deletedAt])
  @@index([name])
}

model Equipment {
  id                String          @id @default(uuid()) // MaThietBi
  assetCode         String          @unique
  serialNumber      String?         @unique
  name              String
  quantity          Int
  unitPrice         Decimal         @db.Decimal(18, 2)
  totalAmount       Decimal         @db.Decimal(18, 2)
  purchaseDate      DateTime
  warrantyExpiresAt DateTime?
  nextMaintenanceAt DateTime?
  location          String?
  notes             String?
  status            EquipmentStatus @default(IN_USE) // Quản lý vòng đời thiết bị
  liquidatedAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  cashTransactionId String?          @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: SetNull)

  lifecycleEvents EquipmentLifecycleEvent[]

  @@index([deletedAt, status])
  @@index([nextMaintenanceAt])
}

model EquipmentLifecycleEvent {
  id         String           @id @default(uuid())
  fromStatus EquipmentStatus?
  toStatus   EquipmentStatus
  reason     String
  cost       Decimal          @default(0) @db.Decimal(18, 2)
  occurredAt DateTime         @default(now())
  createdAt  DateTime         @default(now())

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([equipmentId, occurredAt])
  @@index([employeeId])
}

// =============================================
// 2. ENTITY TABLES (Các bảng thực thể chứa khóa ngoại)
// =============================================

model Employee {
  id          String   @id @default(uuid()) // MaNhanVien
  email       String   @unique /// @zod.string.email()
  avatarUrl   String?
  fullName    String // HoTen
  address     String? // DiaChi
  phoneNumber String? // SoDienThoai
  username    String   @unique // TenDangNhap
  ///FAKE:faker.internet.password()
  password    String // MatKhau
  salary      Decimal? @db.Decimal(18, 2)
  isActive    Boolean  @default(true) // TrangThai

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  positionId String // MaChucVu
  position   Position @relation(fields: [positionId], references: [id])

  employeeRoles          EmployeeRole[]
  orderSessions          OrderSession[]
  invoices               Invoice[]
  actionLogs             ActionLog[]
  cashTransactions       CashTransaction[]
  reservations           Reservation[]
  equipment              Equipment[]
  equipmentEvents        EquipmentLifecycleEvent[]
  printSetting           PrintSetting?
  shifts                 CashierShift[]
  authSessions           AuthSession[]
  passwordResetTokens    PasswordResetToken[]
  inventoryWastes        InventoryWaste[]
  updatedSettings        SystemSetting[]           @relation("SystemSettingUpdatedBy")
  settingRevisions       SystemSettingRevision[]   @relation("SystemSettingRevisionEmployee")
  requestedCashExpenses  CashExpenseRequest[]      @relation("CashExpenseRequestedBy")
  resolvedCashExpenses   CashExpenseRequest[]      @relation("CashExpenseResolvedBy")
  requestedCashHandovers CashHandover[]            @relation("CashHandoverRequestedBy")
  resolvedCashHandovers  CashHandover[]            @relation("CashHandoverResolvedBy")
  settledCashHandovers   CashHandover[]            @relation("CashHandoverSettledBy")
  importedBankStatements BankStatementImport[]
  paymentAttempts        PaymentAttempt[]          @relation("PaymentAttemptCreatedBy")
  idempotencyRequests    IdempotencyRequest[]
}

model AuthSession {
  id               String    @id @default(uuid())
  familyId         String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, usedAt])
  @@index([expiresAt])
}

model InventoryCategory {
  id          String  @id @default(uuid())
  name        String // VD: Nguyên liệu pha chế, Đồ đóng chai, Vật dụng
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  inventoryItems InventoryItem[]

  @@index([deletedAt])
  @@index([name])
}

model InventoryItem {
  id    String  @id @default(uuid()) // MaHangHoa
  name  String // TenHangHoa
  stock Decimal @default(0) @db.Decimal(18, 4) // Số lượng tồn kho hiện tại

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categoryId String
  category   InventoryCategory @relation(fields: [categoryId], references: [id])

  unitId String // MaDonViTinh
  unit   Unit   @relation(fields: [unitId], references: [id])

  ingredients  MenuItemIngredient[]
  transactions InventoryTransaction[]
  snapshots    OrderItemIngredientSnapshot[]

  @@index([categoryId])
  @@index([unitId])
  @@index([deletedAt])
  @@index([name])
  @@index([stock])
}

// =============================================
// 3. DETAIL / JUNCTION TABLES
// =============================================

model Reservation {
  id                 Int               @id @default(autoincrement()) // MaCTDatBan
  customerName       String?
  phoneNumber        String
  startsAt           DateTime
  endsAt             DateTime
  guestCount         Int               @default(1)
  notes              String?
  checkedInAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  noShowAt           DateTime?
  status             ReservationStatus @default(PENDING) // Trạng thái đặt bàn

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId String // MaBan
  table   DiningTable @relation(fields: [tableId], references: [id])

  employeeId String // MaNhanVien
  employee   Employee @relation(fields: [employeeId], references: [id])

  orderSessionId String?       @unique
  orderSession   OrderSession? @relation(fields: [orderSessionId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
  @@index([tableId, startsAt])
  @@index([phoneNumber])
}

model CashierShift {
  id                   String      @id @default(uuid())
  openedAt             DateTime    @default(now())
  closedAt             DateTime?
  startingCash         Decimal     @default(0) @db.Decimal(18, 2) // Tiền lẻ có sẵn đầu ca
  expectedStartingCash Decimal     @default(0) @db.Decimal(18, 2)
  openingDifference    Decimal     @default(0) @db.Decimal(18, 2)
  reportedEndingCash   Decimal?    @db.Decimal(18, 2) // Số tiền mặt thu ngân đếm được khi chốt ca
  actualEndingCash     Decimal?    @db.Decimal(18, 2) // Số tiền mặt hệ thống tính toán (để kiểm tra chênh lệch)
  closingNote          String?
  status               ShiftStatus @default(OPEN)

  employeeId String // Ai là người giữ ca này
  employee   Employee @relation(fields: [employeeId], references: [id])

  fundId String?
  fund   Fund?   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  orderSessions    OrderSession[]
  invoices         Invoice[]
  cashTransactions CashTransaction[] // Lưu các khoản thu/chi phát sinh trong ca
  expenseRequests  CashExpenseRequest[]
  cashHandovers    CashHandover[]
  paymentAttempts  PaymentAttempt[]

  @@index([employeeId, status, openedAt])
  @@index([fundId, status])
  @@index([status, closedAt])
}

model MenuItemIngredient {
  menuItemId String // MaThucDon
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  inventoryItemId String // MaHangHoa
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  quantity Decimal @db.Decimal(18, 4) // DinhLuong

  createdAt DateTime @default(now())

  @@id([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  type            InventoryTxType // IMPORT (Nhập), EXPORT (Xuất)
  quantity        Decimal         @db.Decimal(18, 4)
  unitPrice       Decimal?        @db.Decimal(18, 2)
  totalAmount     Decimal?        @db.Decimal(18, 2)
  transactionDate DateTime
  note            String?

  createdAt DateTime @default(now())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  @@unique([orderItemId, inventoryItemId])
  @@index([inventoryItemId])
  @@index([type, transactionDate])
  @@index([transactionDate])
  @@index([inventoryItemId, transactionDate])
}

model OrderItemIngredientSnapshot {
  orderItemId       String
  inventoryItemId   String
  inventoryItemName String
  unitName          String
  quantityPerItem   Decimal  @db.Decimal(18, 4)
  totalQuantity     Decimal  @db.Decimal(18, 4)
  createdAt         DateTime @default(now())

  orderItem     OrderItem       @relation(fields: [orderItemId], references: [id])
  inventoryItem InventoryItem   @relation(fields: [inventoryItemId], references: [id])
  waste         InventoryWaste?

  @@id([orderItemId, inventoryItemId])
  @@index([inventoryItemId])
}

model InventoryWaste {
  id              String   @id @default(uuid())
  orderItemId     String
  inventoryItemId String
  quantity        Decimal  @db.Decimal(18, 4)
  reason          String
  createdAt       DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  snapshot OrderItemIngredientSnapshot @relation(fields: [orderItemId, inventoryItemId], references: [orderItemId, inventoryItemId])

  @@unique([orderItemId, inventoryItemId])
  @@index([inventoryItemId, createdAt])
  @@index([employeeId])
  @@index([createdAt])
}

// =============================================
// 4. OTHER TABLES
// =============================================

model SystemSetting {
  id          String           @id @default(uuid()) // MaCaiDat
  key         String           @unique
  value       Json
  valueType   SettingValueType
  description String? // MoTa
  isPublic    Boolean          @default(false)
  isSystem    Boolean          @default(false)
  version     Int              @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  updatedById String?
  updatedBy   Employee? @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  revisions SystemSettingRevision[]

  @@index([deletedAt, key])
}

model SystemSettingRevision {
  id          String           @id @default(uuid())
  version     Int
  value       Json
  valueType   SettingValueType
  description String?
  isPublic    Boolean
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?

  settingId String
  setting   SystemSetting @relation(fields: [settingId], references: [id], onDelete: Restrict)

  employeeId String?
  employee   Employee? @relation("SystemSettingRevisionEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@unique([settingId, version])
  @@index([settingId, createdAt])
  @@index([employeeId])
}

// =============================================
// REFACTORED: F&B CORE TRANSACTIONS
// =============================================

// Quản lý Phiên phục vụ (Đại diện cho 1 lần khách vào quán)
model OrderSession {
  id            String        @id @default(uuid())
  sessionStatus SessionStatus @default(ACTIVE) // TinhTrang: ACTIVE, COMPLETED, CANCELLED
  guestCount    Int? // So luong khach

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableId String? // MaBan (Có thể null nếu bán mang đi - Takeaway)
  table   DiningTable? @relation(fields: [tableId], references: [id])

  employeeId String // Nhan vien phuc vu/mo ban
  employee   Employee @relation(fields: [employeeId], references: [id])

  orderItems OrderItem[]
  invoices   Invoice[] // 1 Session có thể xuất ra nhiều Invoices (Tách Bill)

  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id])

  reservation Reservation?

  @@index([sessionStatus, createdAt])
  @@index([tableId, sessionStatus])
  @@index([employeeId])
  @@index([shiftId])
}

//Chi tiết món ăn khách gọi trong phiên
model OrderItem {
  id          String  @id @default(uuid())
  quantity    Int
  priceAtTime Decimal @db.Decimal(18, 2) // GiaTien tai thoi diem goi
  note        String? // Ghi chu (VD: Khong hanh)

  serveStatus ServeStatus @default(PENDING) // TrangThaiBep: PENDING, COOKING, SERVED, CANCELLED
  isPaid      Boolean     @default(false) // Danh dau mon da duoc thanh toan chua

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderSessionId String
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id])

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  ingredientSnapshots   OrderItemIngredientSnapshot[]
  inventoryTransactions InventoryTransaction[]

  @@index([orderSessionId])
  @@index([menuItemId])
  @@index([invoiceId])
  @@index([serveStatus])
  @@index([isPaid])
}

// Hóa đơn thanh toán - In phiếu thanh toán
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  subTotal       Decimal       @db.Decimal(18, 2) // Tổng tiền hàng
  discountAmount Decimal       @default(0) @db.Decimal(18, 2) // Tiền giảm giá
  totalAmount    Decimal       @db.Decimal(18, 2) // Tiền thực thu
  amountTendered Decimal?      @db.Decimal(18, 2) // Tiền khách đưa
  changeAmount   Decimal?      @db.Decimal(18, 2) // Tiền thối lại
  paymentMethod  PaymentMethod @default(CASH)
  paymentStatus  PaymentStatus @default(UNPAID)
  taxAmount      Decimal       @default(0) @db.Decimal(18, 2) // Số tiền thuế
  taxRate        Decimal       @default(0) @db.Decimal(5, 2) // % Thuế (VD: 8, 10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderSessionId String
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  shiftId String?
  shift   CashierShift? @relation(fields: [shiftId], references: [id])

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  orderItems      OrderItem[]
  cashTransaction CashTransaction?
  paymentAttempts PaymentAttempt[]

  @@index([orderSessionId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([paymentStatus, createdAt])
  @@index([createdAt])
}

model PaymentAttempt {
  id                       String               @id @default(uuid())
  provider                 PaymentProvider      @default(VNPAY)
  status                   PaymentAttemptStatus @default(PENDING)
  amount                   Decimal              @db.Decimal(18, 2)
  currency                 String               @default("VND")
  merchantReference        String               @unique
  idempotencyKey           String
  requestHash              String
  providerTransactionNo    String?              @unique
  failureCode              String?
  closeSessionAfterPayment Boolean              @default(true)
  expiresAt                DateTime
  completedAt              DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  createdById String
  createdBy   Employee @relation("PaymentAttemptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  shiftId String
  shift   CashierShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  webhookEvents PaymentWebhookEvent[]

  @@unique([createdById, idempotencyKey])
  @@index([invoiceId, status, createdAt])
  @@index([status, expiresAt])
  @@index([createdById, createdAt])
  @@index([shiftId, createdAt])
}

model PaymentWebhookEvent {
  id                    String          @id @default(uuid())
  provider              PaymentProvider
  payloadHash           String          @unique
  merchantReference     String?
  providerTransactionNo String?
  responseCode          String?
  transactionStatus     String?
  payload               Json
  processingCode        String?
  receivedAt            DateTime        @default(now())
  processedAt           DateTime?

  paymentAttemptId String?
  paymentAttempt   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([provider, receivedAt])
  @@index([merchantReference, receivedAt])
  @@index([paymentAttemptId, receivedAt])
}

model IdempotencyRequest {
  id          String                   @id @default(uuid())
  operation   String
  key         String
  requestHash String
  status      IdempotencyRequestStatus @default(PROCESSING)
  response    Json?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  completedAt DateTime?
  expiresAt   DateTime

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, operation, key])
  @@index([expiresAt])
}

model OutboxEvent {
  id            String            @id @default(uuid())
  topic         String
  eventName     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  lastError     String?
  occurredAt    DateTime          @default(now())
  publishedAt   DateTime?

  @@index([status, availableAt, occurredAt])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([topic, eventName, occurredAt])
}

// Quản lý Ngân sách / Thu Chi (NGANSACH.THU, CHI, NGAY, SOTIEN)
model CashTransaction {
  id              String       @id @default(uuid())
  type            CashFlowType // INCOME (Thu), EXPENSE (Chi)
  amount          Decimal      @db.Decimal(18, 2)
  description     String
  transactionDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fundId String // Nguồn tiền xuất/nhập
  fund   Fund   @relation(fields: [fundId], references: [id])

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  shiftId String? // Khoản chi/thu này phát sinh trong ca nào
  shift   CashierShift? @relation(fields: [shiftId], references: [id])

  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  expenseRequest CashExpenseRequest?

  sourceHandover      CashHandover? @relation("CashHandoverSourceTransaction")
  destinationHandover CashHandover? @relation("CashHandoverDestinationTransaction")
  varianceHandover    CashHandover? @relation("CashHandoverVarianceTransaction")

  equipment Equipment?

  @@index([fundId, transactionDate])
  @@index([shiftId, transactionDate])
  @@index([employeeId, transactionDate])
}

model CashExpenseRequest {
  id             String                   @id @default(uuid())
  amount         Decimal                  @db.Decimal(18, 2)
  description    String
  status         CashExpenseRequestStatus @default(PENDING)
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  requestedById String
  requestedBy   Employee @relation("CashExpenseRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  resolvedById String?
  resolvedBy   Employee? @relation("CashExpenseResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  shiftId String
  shift   CashierShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  cashTransactionId String?          @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([shiftId, status])
  @@index([requestedById, status])
}

model CashHandover {
  id                String                       @id @default(uuid())
  expectedCash      Decimal                      @db.Decimal(18, 2)
  countedCash       Decimal                      @db.Decimal(18, 2)
  varianceAmount    Decimal                      @db.Decimal(18, 2)
  retainedCash      Decimal                      @db.Decimal(18, 2)
  transferAmount    Decimal                      @db.Decimal(18, 2)
  note              String?
  status            CashHandoverStatus           @default(PENDING)
  settlementStatus  CashHandoverSettlementStatus @default(NOT_REQUIRED)
  resolutionNote    String?
  resolvedAt        DateTime?
  settlementDueAt   DateTime?
  settledAt         DateTime?
  bankReference     String?
  evidenceReference String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  requestedById String
  requestedBy   Employee @relation("CashHandoverRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  resolvedById String?
  resolvedBy   Employee? @relation("CashHandoverResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  settledById String?
  settledBy   Employee? @relation("CashHandoverSettledBy", fields: [settledById], references: [id], onDelete: Restrict)

  shiftId String
  shift   CashierShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  sourceFundId String
  sourceFund   Fund   @relation("CashHandoverSourceFund", fields: [sourceFundId], references: [id], onDelete: Restrict)

  destinationFundId String
  destinationFund   Fund   @relation("CashHandoverDestinationFund", fields: [destinationFundId], references: [id], onDelete: Restrict)

  sourceTransactionId String?          @unique
  sourceTransaction   CashTransaction? @relation("CashHandoverSourceTransaction", fields: [sourceTransactionId], references: [id], onDelete: Restrict)

  destinationTransactionId String?          @unique
  destinationTransaction   CashTransaction? @relation("CashHandoverDestinationTransaction", fields: [destinationTransactionId], references: [id], onDelete: Restrict)

  varianceTransactionId String?          @unique
  varianceTransaction   CashTransaction? @relation("CashHandoverVarianceTransaction", fields: [varianceTransactionId], references: [id], onDelete: Restrict)

  bankStatementEntry BankStatementEntry?

  @@unique([destinationFundId, bankReference])
  @@index([status, createdAt])
  @@index([shiftId, status])
  @@index([sourceFundId, createdAt])
  @@index([destinationFundId, createdAt])
  @@index([requestedById, status])
  @@index([settlementStatus, settlementDueAt])
}

model BankStatementImport {
  id             String   @id @default(uuid())
  sourceFileName String
  statementFrom  DateTime
  statementTo    DateTime
  checksum       String
  createdAt      DateTime @default(now())

  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  importedById String
  importedBy   Employee @relation(fields: [importedById], references: [id], onDelete: Restrict)

  entries BankStatementEntry[]

  @@unique([fundId, checksum])
  @@index([fundId, createdAt])
  @@index([statementFrom, statementTo])
}

model BankStatementEntry {
  id              String                      @id @default(uuid())
  externalId      String
  direction       BankStatementEntryDirection
  amount          Decimal                     @db.Decimal(18, 2)
  transactionDate DateTime
  bankReference   String?
  description     String?
  matchStatus     BankStatementMatchStatus    @default(UNMATCHED)
  mismatchReason  String?
  matchedAt       DateTime?
  ignoredAt       DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  importId String
  import   BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Restrict)

  matchedHandoverId String?       @unique
  matchedHandover   CashHandover? @relation(fields: [matchedHandoverId], references: [id], onDelete: Restrict)

  @@unique([fundId, externalId])
  @@index([importId, transactionDate])
  @@index([fundId, matchStatus, transactionDate])
  @@index([matchStatus, transactionDate])
  @@index([fundId, bankReference])
}

// Cài đặt in ấn máy POS
model PrintSetting {
  id          String @id @default(uuid())
  paperSize   String // Khổ giấy
  printerName String // Máy in
  printLimit  Int    @default(1) // Số lần in/giới hạn in

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// Lịch sử thao tác nghiệp vụ (Audit Log)
model ActionLog {
  id         String @id @default(uuid())
  actionType String // VD: TRANSFER_TABLE, MERGE_TABLE, CANCEL_ITEM
  details    Json // Dữ liệu chi tiết sự thay đổi

  createdAt DateTime @default(now())
  requestId String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([requestId])
  @@index([employeeId, createdAt])
}
