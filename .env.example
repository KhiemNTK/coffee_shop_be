NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_PREFIX=/api/v1
APP_NAME=coffee_shop_be
# Public store identity; provide real pickup/contact details before go-live.
SHOP_NAME=Coffee Homes
SHOP_ADDRESS=3 Phố Nhổn, Từ Liêm, Hà Nội
SHOP_PHONE=0973336850
# Single-VPS deployment only; set real values in the ignored .env.production.
APP_DOMAIN=
REDIS_PASSWORD=
VITE_TURNSTILE_SITE_KEY=
JSON_BODY_LIMIT=1mb
TRUST_PROXY=loopback
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coffee_shop
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_shop?schema=public
REDIS_URL=redis://localhost:6379
FE_URL=http://localhost:3001
JWT_SECRET=development-access-secret-change-before-production
JWT_REFRESH_SECRET=development-refresh-secret-change-before-production
PASSWORD_RESET_URL=http://localhost:3001/reset-password
AUTH_SIGNUP_ENABLED=false
# Optional Google Sign-In (frontend uses the same web client ID).
GOOGLE_CLIENT_ID=
# Required in production. Frontend also needs its public Turnstile sitekey.
TURNSTILE_SECRET_KEY=
CSRF_ENABLED=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
SWAGGER_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
METRICS_ENABLED=true
METRICS_TOKEN=development-metrics-token-change-before-production
OUTBOX_POLL_INTERVAL_MS=1000
# Scheduled pickup is disabled until capacity and both local times are set.
# ONLINE_PICKUP_SLOT_CAPACITY=4
# ONLINE_PICKUP_OPEN_LOCAL=07:00
# ONLINE_PICKUP_CLOSE_LOCAL=22:00
ONLINE_PICKUP_MIN_LEAD_MINUTES=45
ONLINE_PICKUP_DAYS_AHEAD=7
ONLINE_ASAP_OPEN_LOCAL=07:00
ONLINE_ASAP_CLOSE_LOCAL=22:00
# Required in production; keep stable so reorder links survive JWT rotation.
# ONLINE_REORDER_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Optional: create a bot with BotFather and configure its HTTPS webhook.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=
SHUTDOWN_TIMEOUT_MS=10000
OTEL_ENABLED=false
OTEL_SERVICE_NAME=coffee_shop_be
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
OWNER_EMAIL=
OWNER_USERNAME=
OWNER_FULL_NAME=
OWNER_PASSWORD=
# Optional provider: leave all three credentials blank for cash-only operation.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SERVER_IP=127.0.0.1
VNPAY_API_TIMEOUT_MS=5000
VNPAY_RETURN_URL=
VNPAY_ATTEMPT_TTL_MINUTES=15
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_URL=https://test-payment.momo.vn
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
MOMO_API_TIMEOUT_MS=30000
MOMO_ATTEMPT_TTL_MINUTES=15
# Optional payOS: configure all four values together. Register the HTTPS webhook in payOS dashboard.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=
PAYOS_API_TIMEOUT_MS=5000
PAYOS_ATTEMPT_TTL_MINUTES=15
# Optional manager-only AI. Review Gemini data terms before enabling with real data.
AI_INSIGHTS_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
# Supported text models: gemini-3.5-flash-lite, gemini-3.8-flash (explicit low thinking).
GEMINI_DATA_POLICY_ACKNOWLEDGED=false
GEMINI_TIMEOUT_MS=15000
GEMINI_DAILY_REQUEST_LIMIT=20
GEMINI_MAX_OUTPUT_TOKENS=3000
