NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_PREFIX=/api/v1
APP_NAME=coffee_shop_be
JSON_BODY_LIMIT=1mb
TRUST_PROXY=loopback
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=coffee_shop
DB_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_shop?schema=public
REDIS_URL=redis://localhost:6379
FE_URL=http://localhost:3001
JWT_SECRET=development-access-secret-change-before-production
JWT_REFRESH_SECRET=development-refresh-secret-change-before-production
PASSWORD_RESET_URL=http://localhost:3001/reset-password
AUTH_SIGNUP_ENABLED=false
CSRF_ENABLED=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
SWAGGER_ENABLED=true
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
METRICS_ENABLED=true
METRICS_TOKEN=development-metrics-token-change-before-production
OUTBOX_POLL_INTERVAL_MS=1000
SHUTDOWN_TIMEOUT_MS=10000
OTEL_ENABLED=false
OTEL_SERVICE_NAME=coffee_shop_be
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
OWNER_EMAIL=
OWNER_USERNAME=
OWNER_FULL_NAME=
OWNER_PASSWORD=
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=development-vnpay-sandbox-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SERVER_IP=127.0.0.1
VNPAY_API_TIMEOUT_MS=5000
VNPAY_RETURN_URL=http://localhost:3001/payment/vnpay/return
VNPAY_ATTEMPT_TTL_MINUTES=15
