# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_PREFIX=/api/v1
APP_NAME=coffee_shop_be
FE_URL=http://localhost:3001
JSON_BODY_LIMIT=1mb
TRUST_PROXY=loopback

# Security
JWT_SECRET=replace-with-a-strong-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
PASSWORD_RESET_URL=http://localhost:3001/reset-password
AUTH_SIGNUP_ENABLED=false
CSRF_ENABLED=true
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
SWAGGER_ENABLED=true

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# PostgreSQL
DB_USER=coffee_shop
DB_PASSWORD=replace-me
DB_NAME=coffee_shop
DB_PORT=5432
DB_HOST=localhost
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# Redis is optional in development and mandatory in production
REDIS_URL=redis://localhost:6379

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Controlled OWNER bootstrap. Leave OWNER_EMAIL empty to skip.
OWNER_EMAIL=
OWNER_USERNAME=
OWNER_FULL_NAME=
OWNER_PASSWORD=
